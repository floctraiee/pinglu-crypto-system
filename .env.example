# 平陆运河国密可信采集系统 —— 配置样例
#
# 说明：
#   1. 仓库不会自动加载本文件；它只是“有哪些可配项 + 默认值”的清单。
#   2. 实际生效靠进程环境变量，设置方式见下（任选其一）：
#        CMD        : set CENTER_URL=http://192.168.1.30:8000 && python -m edge_gateway.main
#        PowerShell : $env:CENTER_URL = "http://192.168.1.30:8000"; python -m edge_gateway.main
#      也可以在启动脚本（.cmd）里一次性 set，再启动进程。
#   3. 未设置的项使用括号里的默认值；网关可用 `python -m edge_gateway.config` 查看当前生效值，
#      网关命令行参数 --broker/--port/--topic/--center/--db/--interval 会覆盖环境变量。
#   4. 本文件不含任何密钥、口令与真实地址，请勿把真实凭据写进仓库。

# ============================ 中心平台 ============================
# 中心库路径（默认 center_platform/data/center.db）
# 异机实测、页面演示库、导入登记表时，必须与服务进程使用同一个值
PINGLU_CENTER_DB=

# 离线页降级读取的模拟器待发队列（默认 ./simulator.db）
PINGLU_SIMULATOR_DB=

# 网关只读状态文件路径（默认依次尝试 edge_gateway/data/gateway_status.json、
# edge_gateway/gateway_status.json，都不存在时降级读 PINGLU_SIMULATOR_DB）
PINGLU_GATEWAY_STATUS=

# 中心库 SQLite 持久化策略（默认 WAL + NORMAL，官方推荐组合，写入吞吐更高）
# 回退到优化前配置做对照：PINGLU_SQLITE_JOURNAL=DELETE  PINGLU_SQLITE_SYNC=FULL
# 可选值：JOURNAL = WAL / DELETE / TRUNCATE / PERSIST / MEMORY
#         SYNC    = OFF / NORMAL / FULL / EXTRA
# 注意：WAL + NORMAL 在突然断电时可能丢失最后若干事务；网关侧固定 WAL + FULL，不受这两项影响。
PINGLU_SQLITE_JOURNAL=
PINGLU_SQLITE_SYNC=

# ============================ 边缘网关 ============================
# MQTT Broker 地址与端口（默认 127.0.0.1 / 1883）
MQTT_BROKER=
MQTT_PORT=

# 订阅主题（默认 pinglu/batches/+）
MQTT_TOPIC=

# MQTT 客户端 ID 与心跳（默认 edge-gateway / 60）
MQTT_CLIENT_ID=
MQTT_KEEPALIVE=

# 中心平台地址（默认 http://127.0.0.1:8000）
CENTER_URL=

# 网关本地缓存库（默认 edge_gateway/data/edge_cache.db）
DB_PATH=

# 预登记公钥文件（默认 test_data/registry_public.json）
# 注意：只能指向主登记表，不要指向 test_data/migration_wl900_to_wl001/ 之类中间产物
REGISTRY_PATH=

# 无新批次时的重试扫描间隔（秒，默认 5）
RETRY_INTERVAL=

# 单次 POST 超时（秒，默认 10）
HTTP_TIMEOUT=

# 单条 MQTT 消息上限（字节，默认 1048576）
MAX_MESSAGE_BYTES=

# 一轮转发中同一设备最多连发几批（默认 20；串行按序，遇未确认批次即停）
MAX_PER_DEVICE_PER_ROUND=

# ===================== 设备端（命令行参数，非环境变量） =====================
# 下面这些不是环境变量，列在这里便于集中查阅：
#   python -m device_simulator.runner --devices 7 --rate 1 --batch-size 10 --rounds 1 \
#       --seed 2026 --keys-dir keys --registry test_data/registry_public.json \
#       --db-path simulator.db [--broker 127.0.0.1 --port 1883]
#   python -m device_simulator.publish --batch-file <批次JSON> --registry <登记表> \
#       [--broker <IP> --port 1883] [--dry-run]
# MQTT 口令请放在环境变量里，用 --password-env <变量名> 传入，不要写在命令行或仓库中。
